{
  "name": "journey",
  "version": "0.0.2",
  "description": "My trips and journeys",
  "private": true,
  "scripts": {
    "prebuild": "tsc -b",
    "test": "node scripts/boot-check.mjs",
    "build": "webpack --config=webpack.prod.js",
    "postbuild": "cp index.html dist/index.html",
    "build-dev": "webpack --config=webpack.dev.js",
    "start": "tsc -b --watch --preserveWatchOutput & webpack serve --config=webpack.dev.js",
    "dev": "tsc -b --watch --preserveWatchOutput & webpack serve --config=webpack.dev.js"
  },
  "keywords": [
    "trips",
    "journeys",
    "3d",
    "threejs"
  ],
  "author": "Anubhab Patnaik",
  "license": "ISC",
  "dependencies": {
    "three": "^0.128.0",
    "three-globe": "^2.18.8",
    "three-glow-mesh": "^0.1.2",
    "typescript": "^4.8.3"
  },
  "devDependencies": {
    "file-loader": "^6.2.0",
    "json-loader": "^0.5.7",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
